<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="700.0" minWidth="1000.0" spacing="15.0" stylesheets="@../styles/FbiTheme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fbi.criminal_justice_system.controllers.CriminalController">
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="15.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="section-title" text="Listado de Criminales">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
                     <children>
                        <TextField fx:id="txtSearchCriminal" maxHeight="30.0" maxWidth="250.0" minHeight="30.0" minWidth="250.0" prefHeight="30.0" prefWidth="250.0" promptText="Buscar por nombre o alias..." styleClass="text-field" />
                        <Button fx:id="btnSearchCriminal" mnemonicParsing="false" onAction="#onActionBtnSearchCriminal" styleClass="btn-secondary" text="Buscar" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </VBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
               <children>
                  <Button fx:id="btnAddCriminal" maxHeight="75.0" maxWidth="140.0" minHeight="75.0" minWidth="125.0" mnemonicParsing="false" onAction="#onActionBtnAddCriminal" prefHeight="75.0" prefWidth="140.0" styleClass="btn-primary" text="Aregar Criminal" />
               </children>
            </HBox>
         </children>
      </HBox>
      <TableView fx:id="tableCriminals" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" minWidth="50.0" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colName" minWidth="160.0" prefWidth="160.0" text="Nombre" />
            <TableColumn fx:id="colAlias" minWidth="120.0" prefWidth="120.0" text="Alias" />
            <TableColumn fx:id="colCrime" minWidth="160.0" prefWidth="160.0" text="Delito" />
            <TableColumn fx:id="colDangerLevel" minWidth="100.0" prefWidth="100.0" text="Peligrosidad" />
            <TableColumn fx:id="colStatus" minWidth="100.0" prefWidth="100.0" text="Estatus" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
