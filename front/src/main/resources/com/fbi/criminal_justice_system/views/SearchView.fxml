<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="700.0" minWidth="1000.0" spacing="15.0" stylesheets="@../styles/FbiTheme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fbi.criminal_justice_system.controllers.SearchController">
   <children>
      <VBox spacing="6.0">
         <children>
            <Label styleClass="section-title" text="Búsqueda Avanzada" />
            <Label styleClass="section-subtitle" text="Combiná los filtros; los vacíos se ignoran. El filtrado lo resuelve el servidor." />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </VBox>

      <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="section-divider" />

      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="form-label" text="NOMBRE, ALIAS O DELITO" />
                  <TextField fx:id="txtSearchText" maxHeight="35.0" minHeight="35.0" minWidth="280.0" prefWidth="280.0" promptText="Texto libre..." styleClass="search-box" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="form-label" text="ESTATUS" />
                  <ComboBox fx:id="cmbStatus" maxHeight="35.0" minHeight="35.0" minWidth="180.0" prefWidth="180.0" promptText="Todos" styleClass="combo-box" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="form-label" text="PELIGROSIDAD" />
                  <ComboBox fx:id="cmbDangerLevel" maxHeight="35.0" minHeight="35.0" minWidth="180.0" prefWidth="180.0" promptText="Todas" styleClass="combo-box" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="BOTTOM_RIGHT" spacing="5.0">
               <children>
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Button fx:id="btnClear" minHeight="35.0" minWidth="110.0" mnemonicParsing="false" onAction="#onActionBtnClear" styleClass="btn-secondary" text="Limpiar" />
                        <Button fx:id="btnSearch" minHeight="35.0" minWidth="110.0" mnemonicParsing="false" onAction="#onActionBtnSearch" styleClass="btn-primary" text="Buscar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>

      <Label fx:id="lblResults" styleClass="section-subtitle" text="" />

      <TableView fx:id="tableResults" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" minWidth="50.0" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colName" minWidth="160.0" prefWidth="160.0" text="Nombre" />
            <TableColumn fx:id="colAlias" minWidth="120.0" prefWidth="120.0" text="Alias" />
            <TableColumn fx:id="colCrime" minWidth="180.0" prefWidth="180.0" text="Delito" />
            <TableColumn fx:id="colDangerLevel" minWidth="110.0" prefWidth="110.0" text="Peligrosidad" />
            <TableColumn fx:id="colStatus" minWidth="100.0" prefWidth="100.0" text="Estatus" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
