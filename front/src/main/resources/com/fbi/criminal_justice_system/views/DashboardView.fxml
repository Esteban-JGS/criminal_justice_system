<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="700.0" minWidth="1000.0" prefHeight="700.0" prefWidth="1000.0" stylesheets="@../styles/FbiTheme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fbi.criminal_justice_system.controllers.DashboardController">
   <top>
      <HBox id="top-bar" alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="125.0" prefHeight="125.0" prefWidth="200.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="15.0" HBox.hgrow="ALWAYS">
               <children>
                  <ImageView fx:id="imgFbiImage" fitHeight="85.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/FBI_icon.png" />
                     </image></ImageView>
                  <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="20.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label id="top-bar-title" fx:id="lblAgent" styleClass="top-bar-title" text="Nombre: Horacio Perez" />
                        <Label fx:id="lblRol" styleClass="top-bar-role" text="Rol: Jefe del FBI" />
                     </children>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </VBox>
               </children>
               <HBox.margin>
                  <Insets bottom="10.0" right="10.0" top="10.0" />
               </HBox.margin>
               <padding>
                  <Insets bottom="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="20.0" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <HBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </HBox.margin>
               <children>
                  <Button fx:id="btnCriminals" layoutX="430.0" layoutY="25.0" maxHeight="75.0" maxWidth="115.0" minHeight="75.0" minWidth="115.0" mnemonicParsing="false" onAction="#onActionBtnCriminals" prefHeight="75.0" prefWidth="115.0" styleClass="btn-primary" text="Criminales" />
                  <Button fx:id="btnSearch" maxHeight="75.0" maxWidth="115.0" minHeight="75.0" minWidth="115.0" mnemonicParsing="false" onAction="#onActionBtnSearch" prefHeight="75.0" prefWidth="115.0" styleClass="btn-primary" text="Buscar" />
                  <Button fx:id="btnLogOut" layoutX="400.0" layoutY="25.0" minHeight="50.0" minWidth="50.0" mnemonicParsing="false" onAction="#onActionBtnLogOut" prefHeight="50.0" prefWidth="70.0" styleClass="btn-logout" text="Salir" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="15.0" />
         </BorderPane.margin>
      </HBox>
   </top>
   <center>
      <VBox alignment="TOP_CENTER" prefHeight="567.0" prefWidth="1000.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblWelcome" />
         </children>
      </VBox>
   </center>
</BorderPane>
